# Copy to .env and fill in. Do NOT commit your real .env.

# ── Supabase ─────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Pinecone ─────────────────────────────────────
PINECONE_API_KEY=<pinecone-api-key>
PINECONE_INDEX_NAME=finley-market

# ── Gemini ───────────────────────────────────────
# Either GEMINI_API_KEY or AI_STUDIO_API_KEY is accepted.
GEMINI_API_KEY=<gemini-api-key>
# AI_STUDIO_API_KEY=<gemini-api-key>
# Embedding dimension for gemini-embedding-001 (must match the Pinecone index).
EMBED_DIM=768

# ── SendBlue ─────────────────────────────────────
SENDBLUE_API_KEY=<sendblue-api-key>
SENDBLUE_FROM_NUMBER=+1XXXXXXXXXX

# ── Kraken (Broker Agent) ────────────────────────
KRAKEN_EMAIL=your-kraken-login@email.com
KRAKEN_PASSWORD=your-kraken-password
SCREENSHOT_BUCKET=trade-screenshots
HEADLESS=true
BROWSER_DATA_DIR=./browser_data

# ── Demo / Development ───────────────────────────
DEMO_MODE=true          # true = simulate Kraken; false = real Playwright execution
PORT=8000
